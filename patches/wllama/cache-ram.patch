+  GLUE_FIELD_NULLABLE(int, cache_ram_mib)
   GLUE_FIELD_NULLABLE(arr_str, lora_paths)
   GLUE_FIELD_NULLABLE(arr_float, lora_scales)
   GLUE_FIELD_NULLABLE(bool, lora_init_without_apply)
